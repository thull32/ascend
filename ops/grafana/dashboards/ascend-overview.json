{
  "uid": "ascend-overview",
  "title": "Ascend overview",
  "tags": [
    "ascend"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "Service level objectives (docs/SLO.md)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Availability, 30 days (objective 99.5%)",
      "description": "Share of API requests that did not fail on our side.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{job=\"ascend-api\", http_route=~\"/api.*\", http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count{job=\"ascend-api\", http_route=~\"/api.*\"}[30d])), 1))"
        }
      ]
    },
