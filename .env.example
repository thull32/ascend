# Copy to .env for local development. Every variable is read once at boot and
# validated (crates/core/src/config.rs); a bad value fails fast.

# --- required ---
DATABASE_URL=postgres://ascend:ascend@localhost:5433/ascend

# --- server ---
PORT=8080
HOST=0.0.0.0
APP_ENV=development                 # production enforces Secure cookies and JSON logs
PUBLIC_ORIGIN=http://localhost:8080 # exact origin for CSRF checks; https in production
# COOKIE_SECURE=true                # defaults to true when PUBLIC_ORIGIN is https
# SESSION_TTL_DAYS=30
# SESSION_IDLE_DAYS=14              # sign out sessions unused this long
# PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com  # screens new passwords (k-anonymity); empty disables
# CLIENT_IP_HEADER=x-real-ip        # only behind a proxy that sets and overwrites it (Railway)
# LOG_JSON=false
RUST_LOG=info,ascend_api=debug,ascend_core=debug

# --- content (authoring) ---
CONTENT_DIR=./content               # read content from disk instead of the embedded copy
# CONTENT_LENIENT=1                 # downgrade dangling cross-references to warnings while writing

# --- grading (learner code runs in a WebAssembly sandbox; `make grader` fetches the runtimes) ---
# GRADER_DIR=runtimes/grader        # the image uses /opt/ascend/grader; required in production
# GRADER_SLOTS=2                    # runs at once; default half the cores, 1-4
# GRADER_URL=http://grader.railway.internal:8080   # grade in the grading service instead of in-process
# GRADER_TOKEN=                     # shared secret with the grading service (32+ chars)

# --- database ---
# DATABASE_POOL_MAX=20              # connections per replica; boot checks the budget

# --- email (password reset, address verification) via Resend ---
# RESEND_API_KEY=                   # without it: development logs emails, production hides recovery
# EMAIL_FROM=Ascend <noreply@your-verified-domain>
# CONTACT_EMAIL=                    # shown on the privacy page

# --- telemetry (OTLP/HTTP push) ---
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_TRACES_SAMPLE_RATIO=1.0

# --- AI (optional: without a key the coach, quizzes and interviews are disabled) ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_DAILY_REQUESTS=120             # per user per UTC day
# AI_DAILY_INPUT_TOKENS=2000000       # billed input: cache writes count 1.25x, reads at the model's price (0.05x on Opus 5.5)
# AI_DAILY_OUTPUT_TOKENS=60000
# AI_TIMEOUT_SECS=180

# --- tests ---
# TEST_DATABASE_URL=postgres://ascend:ascend@localhost:5433/ascend_test
# GRADER_REQUIRED=1                 # fail (not skip) grading tests when the runtimes are missing
