# Copy to .env for local development. Every variable is read once at boot and
# validated (crates/core/src/config.rs); a bad value fails fast.

# --- required ---
DATABASE_URL=postgres://ascend:ascend@localhost:5433/ascend

# --- server ---
PORT=8080
HOST=0.0.0.0
APP_ENV=development                 # production enforces Secure cookies and JSON logs
PUBLIC_ORIGIN=http://localhost:8080 # exact origin for CSRF checks; https in production
# COOKIE_SECURE=true                # defaults to true when PUBLIC_ORIGIN is https
# SESSION_TTL_DAYS=30
# CLIENT_IP_HEADER=x-real-ip        # only behind a proxy that sets and overwrites it (Railway)
# LOG_JSON=false
RUST_LOG=info,ascend_api=debug,ascend_core=debug

# --- content (authoring) ---
CONTENT_DIR=./content               # read content from disk instead of the embedded copy
# CONTENT_LENIENT=1                 # downgrade dangling cross-references to warnings while writing

# --- AI (optional: without a key the coach, quizzes and interviews are disabled) ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_FAST_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_DAILY_REQUESTS=120             # per user per UTC day
# AI_DAILY_INPUT_TOKENS=2000000
# AI_DAILY_OUTPUT_TOKENS=60000
# AI_TIMEOUT_SECS=180

# --- tests ---
# TEST_DATABASE_URL=postgres://ascend:ascend@localhost:5433/ascend_test
