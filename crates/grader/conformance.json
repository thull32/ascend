{
  "description": "When a returned value matches an expected one. Every implementation of the rule must give these answers: web/src/runner/harness.ts (browser, JavaScript), the Python harness in web/src/runner/py.worker.ts (browser, Pyodide), scripts/validate_problems.py (reference solutions), and crates/grader/src/compare.rs (the server's recorded verdict). Floats compare after JavaScript's Math.round(v * 1e6) / 1e6, halves towards +infinity on the scaled binary value; Python's round() rounds halves to even and disagreed at the half-way cases below.",
  "cases": [
    {"expected": 2, "actual": 2.0, "match": true},
    {"expected": 0.333333, "actual": 0.3333333333333333, "match": true},
    {"expected": 1, "actual": 0.9999999999999998, "match": true},
    {"expected": 0.3333, "actual": 0.3333333333333333, "match": false},
    {"expected": 0.1234565, "actual": 0.1234565, "match": true},
    {"expected": 0.1234565, "actual": 0.123457, "match": true},
    {"expected": 0.1234565, "actual": 0.123456, "match": false},
    {"expected": -0.000002, "actual": -0.0000025, "match": true},
    {"expected": 0.000003, "actual": 0.0000025, "match": true},
    {"expected": 0, "actual": 2.5e-7, "match": true},
    {"expected": 0, "actual": -2.5e-7, "match": true},
    {"expected": 0.000001, "actual": 5e-7, "match": true},
    {"expected": 1.000001, "actual": 1.0000005, "match": true},
    {"expected": -1.000001, "actual": -1.0000005, "match": true},
    {"expected": 123.45679, "actual": 123.4567895, "match": true},
    {"expected": 0.5, "actual": 0.4999995, "match": true},
    {"expected": 100000000000000000000, "actual": 1e20, "match": true},
    {"expected": 9007199254740993, "actual": 9007199254740993, "match": true},
    {"expected": 1, "actual": true, "match": false},
    {"expected": "1", "actual": 1, "match": false},
    {"expected": null, "actual": 0, "match": false},
    {"expected": null, "actual": {"$list": []}, "match": true},
    {"expected": {"$tree": []}, "actual": null, "match": true},
    {"expected": {"$list": [1]}, "actual": null, "match": false},
    {"expected": {"b": 1, "a": [1, 2]}, "actual": {"a": [1, 2], "b": 1}, "match": true},
    {"expected": {"x": 0.1234565}, "actual": {"x": 0.123457}, "match": true},
    {"expected": [1, 2], "actual": [2, 1], "match": false},
    {"expected": [1, 2], "actual": [2, 1], "any_order": true, "match": true},
    {"expected": [[1, 2], [3]], "actual": [[3], [1, 2]], "any_order": true, "match": true},
    {"expected": [[1, 2], [3]], "actual": [[3], [2, 1]], "any_order": true, "match": false},
    {"expected": [1, 1, 2], "actual": [1, 2, 2], "any_order": true, "match": false},
    {"expected": [1, 2], "actual": [1, 2, 2], "any_order": true, "match": false},
    {"expected": [0.1234565, 1], "actual": [1, 0.123457], "any_order": true, "match": true},
    {"expected": 3, "actual": 3, "any_order": true, "match": true}
  ]
}
