 "code": "def find_duplicate(nums: list[int]) -> int:\n    slow = fast = 0\n    while True:\n        slow = nums[slow]\n        fast = nums[nums[fast]]\n        if slow == fast:\n            break\n    finder = 0\n    while finder != slow:\n        finder = nums[finder]\n        slow = nums[slow]\n    return finder\n",
