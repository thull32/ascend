 "version": 2,
 "source": "56299e48c8616c68",
 "code": "def routing_loop_detect(destination: str, next_hops: list[list[str | None]]) -> dict[str, list]:\n    nxt = {router: hop for router, hop in next_hops}\n    routers = set(nxt) | {hop for hop in nxt.values() if hop is not None}\n    routers.discard(destination)\n\n    outcome = {destination: \"delivered\"}         # the destination never forwards\n    cycles = []\n    for start in sorted(routers):\n        path, pos = [], {}                        # the current walk, and each router's index on it\n        node = start\n        while node is not None and node not in outcome and node not in pos:\n            pos[node] = len(path)\n            path.append(node)\n            node = nxt.get(node)                  # None: no entry, or an entry with no route\n        if node is None:\n            result = \"black_hole\"\n        elif node in pos:                         # back on our own walk: a new cycle\n            cycle = path[pos[node]:]\n            k = cycle.index(min(cycle))\n            cycles.append(cycle[k:] + cycle[:k])\n            result = \"loop\"\n        else:\n            result = outcome[node]                # inherit a fate found earlier\n        for r in path:\n            outcome[r] = result\n\n    return {\n        \"cycles\": sorted(cycles),\n        \"looping\": sorted(r for r in routers if outcome[r] == \"loop\"),\n        \"black_holed\": sorted(r for r in routers if outcome[r] == \"black_hole\"),\n    }\n",
