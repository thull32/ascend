 "source": "d8c2057eb61ff3b9",
 "code": "def combination_sum2(candidates: list[int], target: int) -> list[list[int]]:\n    candidates = sorted(candidates)\n    result: list[list[int]] = []\n    path: list[int] = []\n\n    def backtrack(start: int, remaining: int) -> None:\n        if remaining == 0:\n            result.append(path[:])\n            return\n        for i in range(start, len(candidates)):\n            c = candidates[i]\n            if c > remaining:\n                break\n            if i > start and c == candidates[i - 1]:\n                continue\n            path.append(c)\n            backtrack(i + 1, remaining - c)\n            path.pop()\n\n    backtrack(0, target)\n    return result\n",
