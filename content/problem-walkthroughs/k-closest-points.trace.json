 "code": "def k_closest(points: list[list[int]], k: int) -> list[list[int]]:\n    heap: list[tuple[int, int, int]] = []\n    for x, y in points:\n        heapq.heappush(heap, (-(x * x + y * y), x, y))\n        if len(heap) > k:\n            heapq.heappop(heap)\n    return [[x, y] for _, x, y in heap]\n",
