 "code": "def remove_k_digits(num: str, k: int) -> str:\n    stack: list[str] = []\n    for d in num:\n        while k > 0 and stack and stack[-1] > d:\n            stack.pop()\n            k -= 1\n        stack.append(d)\n    if k > 0:\n        stack = stack[:-k]  # remaining digits are non-decreasing; drop the largest\n    result = \"\".join(stack).lstrip(\"0\")\n    return result or \"0\"\n",
