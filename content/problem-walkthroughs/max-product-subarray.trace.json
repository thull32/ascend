 "code": "def max_product(nums: list[int]) -> int:\n    hi = lo = best = nums[0]\n    for x in nums[1:]:\n        candidates = (x, hi * x, lo * x)\n        hi, lo = max(candidates), min(candidates)   # both computed from the old pair\n        best = max(best, hi)\n    return best\n",
