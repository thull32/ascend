 "code": "def is_valid_bst(root: TreeNode | None) -> bool:\n    def valid(node, lo, hi):\n        if node is None:\n            return True\n        if not (lo < node.val < hi):\n            return False\n        return valid(node.left, lo, node.val) and valid(node.right, node.val, hi)\n\n    return valid(root, float(\"-inf\"), float(\"inf\"))\n",
