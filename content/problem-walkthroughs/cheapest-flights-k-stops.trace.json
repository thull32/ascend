{
 "problem": "cheapest-flights-k-stops",
 "block": 1,
 "version": 2,
 "source": "93e369b27b085434",
 "code": "def find_cheapest_price(n: int, flights: list[list[int]], src: int, dst: int, k: int) -> int:\n    INF = float(\"inf\")\n    prev = [INF] * n\n    prev[src] = 0\n    for _ in range(k + 1):\n        cur = prev[:]                     # read last round, write this round\n        for u, v, price in flights:\n            if prev[u] + price < cur[v]:\n                cur[v] = prev[u] + price\n        prev = cur\n    return prev[dst] if prev[dst] != INF else -1\n",
