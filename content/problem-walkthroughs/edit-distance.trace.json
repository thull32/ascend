 "version": 2,
 "source": "f11a88650a7b315c",
 "code": "def edit_distance(a: str, b: str) -> int:\n    if len(b) > len(a):\n        a, b = b, a                        # distance is symmetric; keep the row short\n    row = list(range(len(b) + 1))          # D[0][j] = j\n    for i in range(1, len(a) + 1):\n        diag = row[0]                      # D[i-1][0]\n        row[0] = i                         # D[i][0]\n        for j in range(1, len(b) + 1):\n            up = row[j]                    # D[i-1][j]\n            if a[i - 1] == b[j - 1]:\n                row[j] = diag\n            else:\n                row[j] = 1 + min(up, row[j - 1], diag)\n            diag = up\n    return row[len(b)]\n",
 "args": [
  "flaw",
  "lawn"
 ],
