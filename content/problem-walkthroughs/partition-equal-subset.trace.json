{
 "problem": "partition-equal-subset",
 "block": 2,
 "version": 2,
 "source": "9ebf12cb24368d2b",
 "code": "def can_partition(nums: list[int]) -> bool:\n    total = sum(nums)\n    if total % 2:\n        return False\n    target = total // 2\n    reach = [False] * (target + 1)\n    reach[0] = True\n    for x in nums:\n        for s in range(target, x - 1, -1):     # downwards: each item used at most once\n            if reach[s - x]:\n                reach[s] = True\n        if reach[target]:\n            return True                        # early exit\n    return reach[target]\n",
 "args": [
