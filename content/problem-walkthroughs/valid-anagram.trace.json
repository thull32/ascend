 "code": "def is_anagram(s: str, t: str) -> bool:\n    if len(s) != len(t):\n        return False\n    counts: dict[str, int] = {}\n    for ch in s:\n        counts[ch] = counts.get(ch, 0) + 1\n    for ch in t:\n        c = counts.get(ch, 0) - 1\n        if c < 0:\n            return False\n        counts[ch] = c\n    return True\n",
