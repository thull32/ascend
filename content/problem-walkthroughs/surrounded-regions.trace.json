{
 "problem": "surrounded-regions",
 "block": 1,
 "version": 2,
 "source": "2fc5f26e8c314040",
 "code": "def capture_regions(board: list[list[str]]) -> list[list[str]]:\n    if not board or not board[0]:\n        return board\n    rows, cols = len(board), len(board[0])\n\n    def mark_safe(r0: int, c0: int) -> None:\n        if board[r0][c0] != \"O\":\n            return\n        board[r0][c0] = \"#\"\n        stack = [(r0, c0)]\n        while stack:\n            r, c = stack.pop()\n            for nr, nc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):\n                if 0 <= nr < rows and 0 <= nc < cols and board[nr][nc] == \"O\":\n                    board[nr][nc] = \"#\"\n                    stack.append((nr, nc))\n\n    for r in range(rows):\n        mark_safe(r, 0)\n        mark_safe(r, cols - 1)\n    for c in range(cols):\n        mark_safe(0, c)\n        mark_safe(rows - 1, c)\n\n    for r in range(rows):\n        for c in range(cols):\n            if board[r][c] == \"O\":\n                board[r][c] = \"X\"\n            elif board[r][c] == \"#\":\n                board[r][c] = \"O\"\n    return board\n",
