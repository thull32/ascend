 "code": "def add_two_numbers(a: ListNode | None, b: ListNode | None) -> ListNode | None:\n    dummy = ListNode(0)\n    tail = dummy\n    carry = 0\n    while a is not None or b is not None or carry:\n        total = carry\n        if a is not None:\n            total += a.val\n            a = a.next\n        if b is not None:\n            total += b.val\n            b = b.next\n        carry, digit = divmod(total, 10)\n        tail.next = ListNode(digit)\n        tail = tail.next\n    return dummy.next\n",
