 "code": "def is_palindrome(s: str) -> bool:\n    lo, hi = 0, len(s) - 1\n    while lo < hi:\n        while lo < hi and not s[lo].isalnum():\n            lo += 1\n        while lo < hi and not s[hi].isalnum():\n            hi -= 1\n        if s[lo].lower() != s[hi].lower():\n            return False\n        lo += 1\n        hi -= 1\n    return True\n",
