 "code": "def min_cost_climbing_stairs(cost: list[int]) -> int:\n    two_back, one_back = 0, 0          # best[i - 2], best[i - 1]\n    for i in range(2, len(cost) + 1):\n        two_back, one_back = one_back, min(one_back + cost[i - 1], two_back + cost[i - 2])\n    return one_back\n",
