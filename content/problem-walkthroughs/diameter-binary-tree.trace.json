 "code": "def diameter_of_binary_tree(root: TreeNode | None) -> int:\n    best = 0\n\n    def height(node: TreeNode | None) -> int:\n        nonlocal best\n        if node is None:\n            return 0\n        l = height(node.left)\n        r = height(node.right)\n        best = max(best, l + r)\n        return 1 + max(l, r)\n\n    height(root)\n    return best\n",
