 "code": "from collections import deque\n\ndef right_side_view(root: TreeNode | None) -> list[int]:\n    if root is None:\n        return []\n    view: list[int] = []\n    queue = deque([root])\n    while queue:\n        size = len(queue)\n        for i in range(size):\n            node = queue.popleft()\n            if i == size - 1:\n                view.append(node.val)\n            if node.left is not None:\n                queue.append(node.left)\n            if node.right is not None:\n                queue.append(node.right)\n    return view\n",
