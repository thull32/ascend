 "problem": "construct-from-preorder-inorder",
 "block": 1,
 "version": 2,
 "source": "668cce7fb302b6ba",
 "code": "def build_tree(preorder: list[int], inorder: list[int]) -> TreeNode | None:\n    index = {v: i for i, v in enumerate(inorder)}\n    pre_pos = 0\n\n    def build(lo: int, hi: int) -> TreeNode | None:\n        nonlocal pre_pos\n        if lo >= hi:\n            return None\n        val = preorder[pre_pos]\n        pre_pos += 1\n        node = TreeNode(val)\n        mid = index[val]\n        node.left = build(lo, mid)        # must build left first\n        node.right = build(mid + 1, hi)\n        return node\n\n    return build(0, len(inorder))\n",
