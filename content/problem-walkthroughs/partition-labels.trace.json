 "source": "3829b9a7b7a3db84",
 "code": "def partition_labels(s: str) -> list[int]:\n    last = {c: i for i, c in enumerate(s)}   # later writes win: last occurrence\n    sizes: list[int] = []\n    start = end = 0\n    for i, c in enumerate(s):\n        end = max(end, last[c])\n        if i == end:\n            sizes.append(end - start + 1)\n            start = i + 1\n    return sizes\n",
 "args": [
