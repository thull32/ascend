 "code": "def subsets(nums: list[int]) -> list[list[int]]:\n    result: list[list[int]] = []\n    path: list[int] = []\n\n    def backtrack(start: int) -> None:\n        result.append(path[:])\n        for i in range(start, len(nums)):\n            path.append(nums[i])\n            backtrack(i + 1)\n            path.pop()\n\n    backtrack(0)\n    return result\n",
