 "code": "def is_happy(n: int) -> bool:\n    def step(x: int) -> int:\n        total = 0\n        while x:\n            x, d = divmod(x, 10)\n            total += d * d\n        return total\n\n    slow, fast = n, step(n)\n    while fast != 1 and slow != fast:\n        slow = step(slow)\n        fast = step(step(fast))\n    return fast == 1\n",
