 "version": 2,
 "source": "9eaab5cc74510bf2",
 "code": "def replace_words(dictionary: list[str], sentence: str) -> str:\n    root: dict = {}\n    for r in dictionary:\n        node = root\n        for ch in r:\n            node = node.setdefault(ch, {})\n        node[\"$\"] = True\n\n    def shorten(word: str) -> str:\n        node = root\n        for i, ch in enumerate(word):\n            if \"$\" in node:\n                return word[:i]\n            node = node.get(ch)\n            if node is None:\n                return word\n        return word[:len(word)] if \"$\" in node else word\n\n    return \" \".join(shorten(w) for w in sentence.split(\" \"))\n",
 "args": [
  [
   "cat",
   "ca"
  ],
  "cattle dog"
 ],
