{
 "problem": "interleaving-string",
 "block": 2,
 "version": 2,
 "source": "ec8a3c4fb6bc8ec7",
 "code": "def is_interleave(s1: str, s2: str, s3: str) -> bool:\n    m, n = len(s1), len(s2)\n    if m + n != len(s3):\n        return False\n    row = [False] * (n + 1)\n    for i in range(m + 1):\n        for j in range(n + 1):\n            if i == 0 and j == 0:\n                row[0] = True\n                continue\n            c = s3[i + j - 1]\n            from_s1 = i > 0 and row[j] and s1[i - 1] == c         # row[j] is still the row above\n            from_s2 = j > 0 and row[j - 1] and s2[j - 1] == c     # row[j - 1] is this row\n            row[j] = from_s1 or from_s2\n    return row[n]\n",
 "args": [
  "ca",
  "cb",
  "cbca"
 ],
