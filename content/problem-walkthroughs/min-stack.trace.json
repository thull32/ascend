 "code": "class MinStack:\n    def __init__(self):\n        self.vals: list[int] = []\n        self.mins: list[int] = []\n\n    def push(self, val: int) -> None:\n        self.vals.append(val)\n        current_min = val if not self.mins else min(val, self.mins[-1])\n        self.mins.append(current_min)\n\n    def pop(self) -> None:\n        self.vals.pop()\n        self.mins.pop()\n\n    def top(self) -> int:\n        return self.vals[-1]\n\n    def get_min(self) -> int:\n        return self.mins[-1]\n",
