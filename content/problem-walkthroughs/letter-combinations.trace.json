 "source": "687fc7cb762a6a65",
 "code": "def letter_combinations(digits: str) -> list[str]:\n    if not digits:\n        return []\n    keypad = {\n        \"2\": \"abc\", \"3\": \"def\", \"4\": \"ghi\", \"5\": \"jkl\",\n        \"6\": \"mno\", \"7\": \"pqrs\", \"8\": \"tuv\", \"9\": \"wxyz\",\n    }\n    result: list[str] = []\n    path: list[str] = []\n\n    def backtrack(i: int) -> None:\n        if i == len(digits):\n            result.append(\"\".join(path))\n            return\n        for ch in keypad[digits[i]]:\n            path.append(ch)\n            backtrack(i + 1)\n            path.pop()\n\n    backtrack(0)\n    return result\n",
 "args": [
