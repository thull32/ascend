 "source": "f6d5784447e1973f",
 "code": "def count_components(n: int, edges: list[list[int]]) -> int:\n    parent = list(range(n))\n    size = [1] * n\n\n    def find(x: int) -> int:\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]   # path halving\n            x = parent[x]\n        return x\n\n    components = n\n    for a, b in edges:\n        ra, rb = find(a), find(b)\n        if ra == rb:\n            continue                        # edge inside a component\n        if size[ra] < size[rb]:\n            ra, rb = rb, ra\n        parent[rb] = ra                     # union by size\n        size[ra] += size[rb]\n        components -= 1\n    return components\n",
