 "code": "def merge_two_lists(a: ListNode | None, b: ListNode | None) -> ListNode | None:\n    dummy = ListNode(0)\n    tail = dummy\n    while a is not None and b is not None:\n        if a.val <= b.val:\n            tail.next = a\n            a = a.next\n        else:\n            tail.next = b\n            b = b.next\n        tail = tail.next\n    tail.next = a if a is not None else b   # the survivor is already sorted\n    return dummy.next\n",
