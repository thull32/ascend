 "code": "def unique_paths(m: int, n: int) -> int:\n    row = [1] * n                      # the top row\n    for _ in range(1, m):\n        for c in range(1, n):\n            row[c] += row[c - 1]       # above (old row[c]) + left (new row[c - 1])\n    return row[n - 1]\n",
