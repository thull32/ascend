 "version": 2,
 "source": "adbe42e958aaa1d1",
 "code": "def is_match(s: str, p: str) -> bool:\n    n = len(p)\n    prev = [False] * (n + 1)\n    for i in range(len(s) + 1):\n        cur = [False] * (n + 1)\n        cur[0] = i == 0\n        for j in range(1, n + 1):\n            if p[j - 1] == \"*\":\n                cur[j] = cur[j - 2] or (\n                    i > 0 and p[j - 2] in (\".\", s[i - 1]) and prev[j]\n                )\n            else:\n                cur[j] = i > 0 and p[j - 1] in (\".\", s[i - 1]) and prev[j - 1]\n        prev = cur\n    return prev[n]\n",
 "args": [
  "xyyz",
  "xy*z"
 ],
