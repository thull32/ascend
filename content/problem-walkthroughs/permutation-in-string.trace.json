 "problem": "permutation-in-string",
 "block": 1,
 "version": 2,
 "source": "e0f8a7993edc6410",
 "code": "def check_inclusion(s1: str, s2: str) -> bool:\n    m, n = len(s1), len(s2)\n    if m > n:\n        return False\n    need = [0] * 26\n    have = [0] * 26\n    for i in range(m):\n        need[ord(s1[i]) - 97] += 1\n        have[ord(s2[i]) - 97] += 1\n    matches = sum(1 for i in range(26) if need[i] == have[i])\n    if matches == 26:\n        return True\n    for right in range(m, n):\n        enter = ord(s2[right]) - 97\n        leave = ord(s2[right - m]) - 97\n        have[enter] += 1\n        if have[enter] == need[enter]:\n            matches += 1\n        elif have[enter] == need[enter] + 1:\n            matches -= 1\n        have[leave] -= 1\n        if have[leave] == need[leave]:\n            matches += 1\n        elif have[leave] == need[leave] - 1:\n            matches -= 1\n        if matches == 26:\n            return True\n    return False\n",
 "args": [
  "ab",
  "eidbaooo"
 ],
