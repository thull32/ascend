 "code": "def word_break(s: str, words: list[str]) -> bool:\n    vocab = set(words)\n    longest = max(len(w) for w in words)\n    n = len(s)\n    can = [False] * (n + 1)\n    can[0] = True\n    for i in range(1, n + 1):\n        for j in range(max(0, i - longest), i):\n            if can[j] and s[j:i] in vocab:\n                can[i] = True\n                break\n    return can[n]\n",
 "args": [
