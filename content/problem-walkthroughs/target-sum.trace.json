 "code": "def target_sum_ways(nums: list[int], target: int) -> int:\n    total = sum(nums)\n    if abs(target) > total or (total + target) % 2:\n        return 0\n    goal = (total + target) // 2\n    cnt = [0] * (goal + 1)\n    cnt[0] = 1\n    for x in nums:\n        for s in range(goal, x - 1, -1):       # downwards: each number used once\n            cnt[s] += cnt[s - x]\n    return cnt[goal]\n",
