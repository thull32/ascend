 "code": "import bisect\n\ndef length_of_lis(nums: list[int]) -> int:\n    tails: list[int] = []\n    for x in nums:\n        pos = bisect.bisect_left(tails, x)     # first tail >= x\n        if pos == len(tails):\n            tails.append(x)\n        else:\n            tails[pos] = x\n    return len(tails)\n",
