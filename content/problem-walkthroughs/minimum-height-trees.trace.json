{
 "problem": "minimum-height-trees",
 "block": 1,
 "version": 2,
 "source": "e1ecfbe2514083b6",
 "code": "def find_min_height_trees(n: int, edges: list[list[int]]) -> list[int]:\n    if n <= 2:\n        return list(range(n))\n    adj: list[list[int]] = [[] for _ in range(n)]\n    degree = [0] * n\n    for a, b in edges:\n        adj[a].append(b)\n        adj[b].append(a)\n        degree[a] += 1\n        degree[b] += 1\n\n    layer = [v for v in range(n) if degree[v] == 1]\n    remaining = n\n    while remaining > 2:\n        remaining -= len(layer)\n        nxt = []\n        for leaf in layer:\n            for nb in adj[leaf]:\n                degree[nb] -= 1\n                if degree[nb] == 1:\n                    nxt.append(nb)\n        layer = nxt\n    return sorted(layer)\n",
