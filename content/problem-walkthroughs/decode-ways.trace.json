 "code": "def num_decodings(s: str) -> int:\n    two_back, one_back = 0, 1          # ways[i - 2], ways[i - 1]; ways[-1] is never used\n    for i in range(1, len(s) + 1):\n        current = 0\n        if s[i - 1] != \"0\":\n            current += one_back\n        if i >= 2 and \"10\" <= s[i - 2:i] <= \"26\":\n            current += two_back\n        two_back, one_back = one_back, current\n    return one_back\n",
