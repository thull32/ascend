 "code": "class KthLargest:\n    def __init__(self, k: int, nums: list[int]):\n        self.k = k\n        self.heap: list[int] = []\n        for x in nums:\n            self.add(x)\n\n    def add(self, val: int) -> int:\n        heapq.heappush(self.heap, val)\n        if len(self.heap) > self.k:\n            heapq.heappop(self.heap)\n        return self.heap[0]\n",
