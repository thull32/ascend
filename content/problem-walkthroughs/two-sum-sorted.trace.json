 "code": "def two_sum_sorted(nums: list[int], target: int) -> list[int]:\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        s = nums[lo] + nums[hi]\n        if s == target:\n            return [lo, hi]\n        if s < target:\n            lo += 1\n        else:\n            hi -= 1\n    return []  # unreachable given the guarantee\n",
