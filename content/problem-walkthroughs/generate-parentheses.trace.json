 "code": "def generate_parentheses(n: int) -> list[str]:\n    out: list[str] = []\n\n    def build(prefix: str, opened: int, closed: int) -> None:\n        if len(prefix) == 2 * n:\n            out.append(prefix)\n            return\n        if opened < n:\n            build(prefix + \"(\", opened + 1, closed)\n        if closed < opened:\n            build(prefix + \")\", opened, closed + 1)\n\n    build(\"\", 0, 0)\n    return out\n",
 "args": [
  2
 ],
