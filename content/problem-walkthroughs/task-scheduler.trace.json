 "code": "def least_interval(tasks: list[str], n: int) -> int:\n    counts = collections.Counter(tasks)\n    f = max(counts.values())\n    m = sum(1 for c in counts.values() if c == f)\n    return max(len(tasks), (f - 1) * (n + 1) + m)\n",
