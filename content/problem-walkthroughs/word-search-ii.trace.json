 "version": 2,
 "source": "f8257b18fa4d1039",
 "code": "def find_words(board: list[list[str]], words: list[str]) -> list[str]:\n    root: dict = {}\n    for w in words:\n        node = root\n        for ch in w:\n            node = node.setdefault(ch, {})\n        node[\"$\"] = w\n\n    rows, cols = len(board), len(board[0])\n    found: list[str] = []\n\n    def dfs(r: int, c: int, parent: dict) -> None:\n        ch = board[r][c]\n        node = parent.get(ch)\n        if node is None:\n            return\n        word = node.pop(\"$\", None)\n        if word is not None:\n            found.append(word)\n        board[r][c] = \"#\"\n        if r > 0:\n            dfs(r - 1, c, node)\n        if r + 1 < rows:\n            dfs(r + 1, c, node)\n        if c > 0:\n            dfs(r, c - 1, node)\n        if c + 1 < cols:\n            dfs(r, c + 1, node)\n        board[r][c] = ch\n        if not node:\n            del parent[ch]\n\n    for r in range(rows):\n        for c in range(cols):\n            dfs(r, c, root)\n    return found\n",
