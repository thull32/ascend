{
 "problem": "reverse-nodes-k-group",
 "block": 1,
 "version": 2,
 "source": "5d41348c8bbf76f1",
 "code": "def reverse_k_group(head: ListNode | None, k: int) -> ListNode | None:\n    dummy = ListNode(0, head)\n    group_prev = dummy\n\n    while True:\n        # 1. is there a full group ahead?\n        kth = group_prev\n        for _ in range(k):\n            kth = kth.next\n            if kth is None:\n                return dummy.next\n        group_next = kth.next\n\n        # 2-3. reverse exactly k nodes, landing on group_next\n        prev, cur = group_next, group_prev.next\n        for _ in range(k):\n            nxt = cur.next\n            cur.next = prev\n            prev = cur\n            cur = nxt\n\n        # 4. reconnect\n        first = group_prev.next   # old first node, now the group's tail\n        group_prev.next = kth\n        group_prev = first\n",
 "args": [
