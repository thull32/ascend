 "code": "def lowest_common_ancestor(root: TreeNode | None, p: int, q: int) -> int:\n    lo, hi = min(p, q), max(p, q)\n    node = root\n    while node is not None:\n        if hi < node.val:\n            node = node.left\n        elif lo > node.val:\n            node = node.right\n        else:\n            return node.val\n    return -1  # unreachable: p and q are guaranteed to exist\n",
