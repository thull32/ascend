 "source": "d228074310643e5f",
 "code": "def count_palindromic_substrings(s: str) -> int:\n    n = len(s)\n    count = 0\n    for centre in range(2 * n - 1):\n        lo = centre // 2\n        hi = lo + centre % 2\n        while lo >= 0 and hi < n and s[lo] == s[hi]:\n            count += 1\n            lo -= 1\n            hi += 1\n    return count\n",
 "args": [
  "abba"
 ],
