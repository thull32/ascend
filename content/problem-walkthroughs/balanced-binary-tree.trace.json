 "code": "def is_balanced(root: TreeNode | None) -> bool:\n    UNBALANCED = -1\n\n    def height(node: TreeNode | None) -> int:\n        if node is None:\n            return 0\n        l = height(node.left)\n        if l == UNBALANCED:\n            return UNBALANCED\n        r = height(node.right)\n        if r == UNBALANCED:\n            return UNBALANCED\n        if abs(l - r) > 1:\n            return UNBALANCED\n        return 1 + max(l, r)\n\n    return height(root) != UNBALANCED\n",
