 "code": "def eval_rpn(tokens: list[str]) -> int:\n    stack: list[int] = []\n    for tok in tokens:\n        if tok in (\"+\", \"-\", \"*\", \"/\"):\n            b = stack.pop()\n            a = stack.pop()\n            if tok == \"+\":\n                stack.append(a + b)\n            elif tok == \"-\":\n                stack.append(a - b)\n            elif tok == \"*\":\n                stack.append(a * b)\n            else:\n                stack.append(int(a / b))  # truncates toward zero\n        else:\n            stack.append(int(tok))\n    return stack[-1]\n",
