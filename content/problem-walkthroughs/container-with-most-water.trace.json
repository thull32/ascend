 "source": "bf8146f936855ece",
 "code": "def max_area(heights: list[int]) -> int:\n    lo, hi = 0, len(heights) - 1\n    best = 0\n    while lo < hi:\n        h = min(heights[lo], heights[hi])\n        best = max(best, (hi - lo) * h)\n        if heights[lo] <= heights[hi]:\n            lo += 1\n        else:\n            hi -= 1\n    return best\n",
