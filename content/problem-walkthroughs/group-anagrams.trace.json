 "problem": "group-anagrams",
 "block": 1,
 "version": 2,
 "source": "2ce9027035a87b94",
 "code": "def group_anagrams(strs: list[str]) -> list[list[str]]:\n    groups: dict[tuple[int, ...], list[str]] = {}\n    for s in strs:\n        counts = [0] * 26\n        for ch in s:\n            counts[ord(ch) - 97] += 1\n        key = tuple(counts)\n        groups.setdefault(key, []).append(s)\n    return [sorted(g) for g in groups.values()]\n",
 "args": [
  [
   "eat",
   "tea",
   "tan"
  ]
 ],
