 "code": "def find_min(nums: list[int]) -> int:\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = lo + (hi - lo) // 2\n        if nums[mid] > nums[hi]:\n            lo = mid + 1   # minimum is right of mid\n        else:\n            hi = mid       # mid could be the minimum\n    return nums[lo]\n",
