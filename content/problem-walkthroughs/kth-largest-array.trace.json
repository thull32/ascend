 "code": "def find_kth_largest(nums: list[int], k: int) -> int:\n    heap: list[int] = []\n    for x in nums:\n        heapq.heappush(heap, x)\n        if len(heap) > k:\n            heapq.heappop(heap)\n    return heap[0]\n",
