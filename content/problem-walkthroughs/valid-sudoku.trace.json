 "source": "250018632570e252",
 "code": "def is_valid_sudoku(board: list[list[str]]) -> bool:\n    seen: set[tuple[str, int, str]] = set()\n    for r in range(9):\n        for c in range(9):\n            d = board[r][c]\n            if d == \".\":\n                continue\n            box = (r // 3) * 3 + c // 3\n            keys = ((\"row\", r, d), (\"col\", c, d), (\"box\", box, d))\n            for key in keys:\n                if key in seen:\n                    return False\n                seen.add(key)\n    return True\n",
