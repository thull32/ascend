 "source": "2b71d84c85bb31b3",
 "code": "def daily_temperatures(temps: list[int]) -> list[int]:\n    n = len(temps)\n    answer = [0] * n\n    stack: list[int] = []  # indices with unresolved answers, temps decreasing bottom to top\n    for i, t in enumerate(temps):\n        while stack and temps[stack[-1]] < t:\n            j = stack.pop()\n            answer[j] = i - j\n        stack.append(i)\n    return answer\n",
