 "source": "23ef92ab5dbc9a57",
 "code": "def longest_consecutive(nums: list[int]) -> int:\n    values = set(nums)\n    best = 0\n    for x in values:\n        if x - 1 in values:\n            continue                 # not the start of a run\n        length = 1\n        while x + length in values:\n            length += 1\n        best = max(best, length)\n    return best\n",
