 "code": "def my_sqrt(x: int) -> int:\n    lo, hi = 0, x\n    answer = 0\n    while lo <= hi:\n        mid = lo + (hi - lo) // 2\n        if mid * mid <= x:\n            answer = mid      # mid works; look for something larger\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return answer\n",
