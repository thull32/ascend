 "code": "import heapq\n\n\nclass _Flow:\n    \"\"\"A flow in the heap. `a < b` means \"a is worse than b\", so the heap's\n    root is the weakest flow still in the top k.\"\"\"\n    __slots__ = (\"total\", \"src\", \"dst\")\n\n    def __init__(self, total: int, src: str, dst: str):\n        self.total, self.src, self.dst = total, src, dst\n\n    def __lt__(self, other: \"_Flow\") -> bool:\n        if self.total != other.total:\n            return self.total < other.total               # fewer bytes is worse\n        return (self.src, self.dst) > (other.src, other.dst)  # larger key loses a tie\n\n\ndef top_k_flows(records: list[list], k: int) -> list[list]:\n    if k <= 0:\n        return []\n    totals: dict[tuple[str, str], int] = {}\n    for src, dst, nbytes in records:\n        totals[(src, dst)] = totals.get((src, dst), 0) + nbytes\n\n    heap: list[_Flow] = []\n    for (src, dst), total in totals.items():\n        flow = _Flow(total, src, dst)\n        if len(heap) < k:\n            heapq.heappush(heap, flow)\n        elif heap[0] < flow:                  # beats the weakest of the best k\n            heapq.heapreplace(heap, flow)\n\n    ranked = []\n    while heap:\n        f = heapq.heappop(heap)               # worst first\n        ranked.append([f.src, f.dst, f.total])\n    ranked.reverse()                          # heaviest first\n    return ranked\n",
