 "code": "def kth_smallest(root: TreeNode | None, k: int) -> int:\n    stack = []\n    node = root\n    while True:\n        while node is not None:\n            stack.append(node)\n            node = node.left\n        node = stack.pop()\n        k -= 1\n        if k == 0:\n            return node.val\n        node = node.right\n",
