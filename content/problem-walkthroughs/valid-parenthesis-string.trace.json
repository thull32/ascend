 "code": "def check_valid_string(s: str) -> bool:\n    lo = hi = 0   # min and max possible number of unmatched '('\n    for ch in s:\n        if ch == \"(\":\n            lo += 1\n            hi += 1\n        elif ch == \")\":\n            lo -= 1\n            hi -= 1\n        else:  # '*'\n            lo -= 1\n            hi += 1\n        if hi < 0:\n            return False          # too many ')' even if every '*' is '('\n        lo = max(lo, 0)           # a negative open count is not a real state\n    return lo == 0\n",
 "args": [
  "(*))"
 ],
