 "code": "def subarray_sum(nums: list[int], k: int) -> int:\n    seen: dict[int, int] = {0: 1}     # the empty prefix\n    running = 0\n    count = 0\n    for x in nums:\n        running += x\n        count += seen.get(running - k, 0)\n        seen[running] = seen.get(running, 0) + 1\n    return count\n",
