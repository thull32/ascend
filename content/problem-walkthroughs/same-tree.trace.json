 "code": "def is_same_tree(p: TreeNode | None, q: TreeNode | None) -> bool:\n    if p is None and q is None:\n        return True\n    if p is None or q is None:\n        return False\n    if p.val != q.val:\n        return False\n    return is_same_tree(p.left, q.left) and is_same_tree(p.right, q.right)\n",
