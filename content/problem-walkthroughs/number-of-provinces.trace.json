 "version": 2,
 "source": "15074f151e4ed79f",
 "code": "def count_provinces(is_connected: list[list[int]]) -> int:\n    n = len(is_connected)\n    parent = list(range(n))\n    size = [1] * n\n\n    def find(x: int) -> int:\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]   # path halving\n            x = parent[x]\n        return x\n\n    count = n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if is_connected[i][j]:\n                ri, rj = find(i), find(j)\n                if ri != rj:\n                    if size[ri] < size[rj]:\n                        ri, rj = rj, ri\n                    parent[rj] = ri\n                    size[ri] += size[rj]\n                    count -= 1\n    return count\n",
