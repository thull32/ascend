 "code": "def length_of_longest_substring(s: str) -> int:\n    last: dict[str, int] = {}\n    left = 0\n    best = 0\n    for right, ch in enumerate(s):\n        if ch in last and last[ch] >= left:\n            left = last[ch] + 1          # jump past the previous occurrence\n        last[ch] = right\n        best = max(best, right - left + 1)\n    return best\n",
